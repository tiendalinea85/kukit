# ==============================================================================
# CatoLedger — Plantilla de variables de entorno
# ==============================================================================
# Copia este archivo como .env.local (desarrollo) o configúralo en tu
# plataforma de despliegue (Vercel, Docker, etc.).
#
# Requerido  = La app NO funciona sin esta variable.
# Opcional   = La app funciona pero con funcionalidad reducida.
# Interna    = Solo para despliegues avanzados / configuración fina.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (Requerido para auth y sync online)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública del proyecto Supabase (Settings → API → anon public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (solo servidor) — necesaria para operaciones admin
# como backups, migraciones y funciones server-side.
# (Settings → API → service_role — ¡NUNCA la expongas al cliente!)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Gemini AI (Requerido para OCR de facturas y asistente de voz)
# ------------------------------------------------------------------------------
# API Key de Google AI Studio (https://aistudio.google.com/apikey).
# Sin esta clave, OCR y voz no funcionan.
GEMINI_API_KEY=

# Modelo de Gemini a utilizar.
# Opciones: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
# Por defecto: gemini-2.5-flash (más rápido y económico).
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
# URL pública de la aplicación (para service worker, metadata y CORS).
# En producción usa tu dominio: https://catoledger.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# Sync Engine (Opcional — valores por defecto razonables)
# ------------------------------------------------------------------------------
# Cantidad de operaciones enviadas por lote al servidor durante el push.
SYNC_BATCH_SIZE=25

# Tiempo en ms antes de marcar una operación como "estancada" y reintentarla.
# 300000 ms = 5 minutos.
SYNC_STALE_THRESHOLD_MS=300000

# ------------------------------------------------------------------------------
# Rate Limiting API (Opcional — protege los endpoints /api/voice y /api/ai/ocr)
# ------------------------------------------------------------------------------
# Número máximo de solicitudes por ventana de tiempo por IP.
API_RATE_LIMIT_MAX=10

# Duración de la ventana de rate limiting en milisegundos.
# 60000 ms = 1 minuto.
API_RATE_LIMIT_WINDOW_MS=60000
