# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cato_ledger

# Supabase JWT secret (from Supabase dashboard -> Settings -> API -> JWT secret)
SUPABASE_JWT_SECRET=change-me
SUPABASE_JWT_ALG=HS256

# CORS allowed origins (JSON array). La app móvil nativa no necesita CORS.
# Ejemplo: CORS_ORIGINS=["https://app.catoledger.com","https://api.catoledger.com"]
CORS_ORIGINS=[]
