{
  "name": "zane-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./register-hooks.ts --test \"src/features/expenses/**/*.test.ts\" \"src/features/investments/**/*.test.ts\" \"src/features/sales/**/*.test.ts\" \"src/features/purchases/**/*.test.ts\" \"src/features/invoice/**/*.test.ts\" \"src/features/tailoring/**/*.test.ts\" \"src/stores/**/*.test.ts\" \"src/lib/sync/**/*.test.ts\" \"src/__tests__/**/*.test.ts\"",
    "test:ci": "node --import ./register-hooks.ts --test --test-reporter=dot \"src/features/expenses/**/*.test.ts\" \"src/features/investments/**/*.test.ts\" \"src/features/sales/**/*.test.ts\" \"src/features/purchases/**/*.test.ts\" \"src/features/invoice/**/*.test.ts\" \"src/features/tailoring/**/*.test.ts\" \"src/stores/**/*.test.ts\" \"src/lib/sync/**/*.test.ts\" \"src/__tests__/**/*.test.ts\"",
    "clean": "node -e \"const {rmSync}=require('fs');['.next','.tsbuildinfo'].forEach(p=>rmSync(p,{recursive:true,force:true}))\"",
    "docker:build": "docker build -t catoledger:latest .",
    "docker:run": "docker run -d --name catoledger -p 3000:3000 --env-file .env.local catoledger:latest",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "health-check": "bash scripts/health-check.sh",
    "android:build": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.0",
    "framer-motion": "^12.6.0",
    "lucide-react": "^0.483.0",
    "next": "^15.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.5.0",
    "recharts": "^2.15.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.23",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
